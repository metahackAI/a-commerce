# Copy to .env (git-ignored). Never commit real keys.
META_API_KEY=

# OpenAI-compatible endpoints (docs/direction.md). The worker is Muse Glimmer
# (nvidia/Muse-Glimmer-30B-NVFP4) served with vLLM on the team's RTX 5090, e.g. WORKER_BASE_URL=https://<tunnel>/v1.
# WORKER_API_KEY must not be empty; use the vLLM --api-key value, or any text if the server has none.
WORKER_BASE_URL=
WORKER_API_KEY=
WORKER_MODEL=
# Optional sampling; the defaults are temperature 0 and 1500 tokens per reply. Raise MAX_TOKENS for reasoning models.
WORKER_TEMPERATURE=
WORKER_MAX_TOKENS=
PLANNER_BASE_URL=https://inference.baseten.co/v1
PLANNER_API_KEY=
PLANNER_MODEL=meta-models/muse-spark-open-1026

# Optional: file path for the SQLite store (default: in memory, reset on restart)
A_COMMERCE_DB=
