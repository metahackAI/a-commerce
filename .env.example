# Copy to .env and fill in. Never commit .env.
META_API_KEY=
META_API_BASE_URL=
SPARK_MODEL=

GLIMMER_BASE_URL=
GLIMMER_MODEL=

DATABASE_URL=postgres://acom:acom@localhost:5432/acom

# Ed25519 PEM keys for gateway-signed internal tokens (generate locally, never commit)
ACOM_GATEWAY_SIGNING_KEY=
ACOM_GATEWAY_PUBLIC_KEY=

ACOM_GATEWAY_ADDR=127.0.0.1:7000
ACOM_COMMERCE_ADDR=127.0.0.1:7001
ACOM_AGENT_ADDR=127.0.0.1:7002
ACOM_COMMERCE_URL=http://127.0.0.1:7001
ACOM_AGENT_URL=http://127.0.0.1:7002
ACOM_WEB_URL=http://127.0.0.1:3000
ACOM_DEMO_MODE=true
