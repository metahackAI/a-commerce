# Copy to .env (make env) and fill in what you need. Never commit .env.
# Compose reads it with --env-file .env; `cargo run` reads the same names from your shell.

# --- Models (agent) ----------------------------------------------------------------------------
# Planner and fallback model through the Meta Model API.
META_API_KEY=
META_API_BASE_URL=
SPARK_MODEL=
# Worker model on an OpenAI-compatible endpoint (self-hosted vLLM). With the compose `models`
# profile this is http://models:8000/v1 and VLLM_MODEL names the model to serve.
GLIMMER_BASE_URL=
GLIMMER_MODEL=
VLLM_MODEL=
HF_TOKEN=

# --- Docker Compose ----------------------------------------------------------------------------
# Host port of the gateway (the only published port): http://localhost:8080
ACOM_HTTP_PORT=8080
ACOM_TAG=local
ACOM_ENV=local
ACOM_DEMO_MODE=true
RUST_LOG=info
# Local database passwords. infra/postgres/init.sql creates the roles with these defaults;
# change both places together if you change them.
POSTGRES_PASSWORD=acom
ACOM_OWNER_PASSWORD=acom_owner
ACOM_APP_PASSWORD=acom_app

# --- Running services directly (cargo run), against `make up-debug`'s published Postgres ------
DATABASE_URL=postgres://acom_app:acom_app@localhost:5432/acom
MIGRATION_DATABASE_URL=postgres://acom_owner:acom_owner@localhost:5432/acom
ACOM_GATEWAY_ADDR=127.0.0.1:7000
ACOM_COMMERCE_ADDR=127.0.0.1:7001
ACOM_AGENT_ADDR=127.0.0.1:7002
ACOM_WORKER_ADDR=127.0.0.1:7003
ACOM_COMMERCE_URL=http://127.0.0.1:7001
ACOM_AGENT_URL=http://127.0.0.1:7002
ACOM_WEB_URL=http://127.0.0.1:3000
ACOM_POLICY_DIR=policies
ACOM_GATEWAY_SIGNING_KEY_FILE=infra/secrets/gateway_signing_key.pem
ACOM_GATEWAY_PUBLIC_KEY_FILE=infra/secrets/gateway_public_key.pem
