      "@id": "acom:learnedAt",
      "@type": "rdf:Property",
      "rdfs:label": "learnedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Preference"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
