{
  "@context": {
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "https://schema.org/",
    "acom": "https://metahackai.github.io/a-commerce/vocab#"
  },
  "@id": "acom:",
  "rdfs:comment": "A-Commerce extension vocabulary. Generated by `cargo xtask check-schema --write` from vocab/terms.json, migration comments, and crates/core/src/enums.rs; do not edit. Rules: docs/api/vocabulary.md.",
  "@graph": [
    {
      "@id": "acom:ApiKey",
      "@type": "rdfs:Class",
      "rdfs:label": "ApiKey",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      },
      "rdfs:comment": "a credential an outside agent or integration client signs in with (login); the secret is shown once when issued and kept only as a hash. id prefix key_."
    },
    {
      "@id": "acom:Banner",
      "@type": "rdfs:Class",
      "rdfs:label": "Banner",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "rdfs:comment": "Content shown in a display slot: headline, image, link. Used as additionalType on a CreativeWork."
    },
    {
      "@id": "acom:Campaign",
      "@type": "rdfs:Class",
      "rdfs:label": "Campaign",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "rdfs:comment": "a marketing message sent to many shoppers at a scheduled time from one template; sending it reaches customers. id prefix cmp_."
    },
    {
      "@id": "acom:CampaignSend",
      "@type": "rdfs:Class",
      "rdfs:label": "CampaignSend",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "rdfs:comment": "one row per campaign: when it was due, whether and when it went out, and why it failed."
    },
    {
      "@id": "acom:Cart",
      "@type": "rdfs:Class",
      "rdfs:label": "Cart",
      "rdfs:subClassOf": {
        "@id": "schema:Order"
      },
      "rdfs:comment": "An order the shopper has not placed yet. Used as additionalType on an Order."
    },
    {
      "@id": "acom:CartLine",
      "@type": "rdfs:Class",
      "rdfs:label": "CartLine",
      "rdfs:subClassOf": {
        "@id": "schema:OrderItem"
      },
      "rdfs:comment": "One line of a cart. Used as additionalType on an OrderItem."
    },
    {
      "@id": "acom:CategoryMapping",
      "@type": "rdfs:Class",
      "rdfs:label": "CategoryMapping",
      "rdfs:subClassOf": {
        "@id": "schema:Intangible"
      },
      "rdfs:comment": "links a standard category to a display category, so the display tree shows the standard category's products. id prefix map_."
    },
    {
      "@id": "acom:CategoryPlacement",
      "@type": "rdfs:Class",
      "rdfs:label": "CategoryPlacement",
      "rdfs:subClassOf": {
        "@id": "schema:Thing"
      },
      "rdfs:comment": "a product placed in a standard or display category; one standard category per product is primary."
    },
    {
      "@id": "acom:ChangeSet",
      "@type": "rdfs:Class",
      "rdfs:label": "ChangeSet",
      "rdfs:subClassOf": {
        "@id": "schema:ItemList"
      },
      "rdfs:comment": "A versioned list of previewed actions that a person approves, runs, and can undo together. Used as additionalType on an ItemList."
    },
    {
      "@id": "acom:Claim",
      "@type": "rdfs:Class",
      "rdfs:label": "Claim",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "A shopper's request to cancel, return, or exchange order items. Used as additionalType on CancelAction (cancel) or ReturnAction (return, exchange)."
    },
    {
      "@id": "acom:ClaimItem",
      "@type": "rdfs:Class",
      "rdfs:label": "ClaimItem",
      "rdfs:subClassOf": {
        "@id": "schema:OrderItem"
      },
      "rdfs:comment": "one order line and quantity inside a claim."
    },
    {
      "@id": "acom:ComplianceRule",
      "@type": "rdfs:Class",
      "rdfs:label": "ComplianceRule",
      "rdfs:subClassOf": {
        "@id": "schema:PropertyValue"
      },
      "rdfs:comment": "A store-defined rule for prize reporting, withholding, or winner information in a jurisdiction."
    },
    {
      "@id": "acom:ConditionalGift",
      "@type": "rdfs:Class",
      "rdfs:label": "ConditionalGift",
      "rdfs:subClassOf": {
        "@id": "schema:Offer"
      },
      "rdfs:comment": "a gift added to an order whose subtotal before member benefits reaches a threshold, with one gift per threshold. id prefix cgf_."
    },
    {
      "@id": "acom:ConsentRecord",
      "@type": "rdfs:Class",
      "rdfs:label": "ConsentRecord",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "one consent given or withdrawn; records are only added, never changed. id prefix cns_. API: consent."
    },
    {
      "@id": "acom:ContentReport",
      "@type": "rdfs:Class",
      "rdfs:label": "ContentReport",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "a shopper's report that a review is inappropriate; it puts the review in the moderation queue. id prefix rpt_."
    },
    {
      "@id": "acom:CopyDraft",
      "@type": "rdfs:Class",
      "rdfs:label": "CopyDraft",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "rdfs:comment": "generated text for a product (generate_copy), kept as a draft until update_product_group uses it. id prefix cpd_."
    },
    {
      "@id": "acom:Coupon",
      "@type": "rdfs:Class",
      "rdfs:label": "Coupon",
      "rdfs:subClassOf": {
        "@id": "schema:Offer"
      },
      "rdfs:comment": "A discount a shopper can apply to an order, identified by schema:discountCode. Used as additionalType on an Offer. It records a benefit on the order; it does not add a second discount on top of a member price."
    },
    {
      "@id": "acom:CustomerInquiry",
      "@type": "rdfs:Class",
      "rdfs:label": "CustomerInquiry",
      "rdfs:subClassOf": {
        "@id": "schema:Message"
      },
      "rdfs:comment": "a customer service inquiry and its state; the thread is in customer.comment. id prefix inq_. API: inquiry."
    },
    {
      "@id": "acom:DailySales",
      "@type": "rdfs:Class",
      "rdfs:label": "DailySales",
      "rdfs:subClassOf": {
        "@id": "schema:Observation"
      },
      "rdfs:comment": "revenue and order count per store and day, with the day taken in the store's time zone; orders still awaiting payment and cancelled orders are left out."
    },
    {
      "@id": "acom:DisplayBooking",
      "@type": "rdfs:Class",
      "rdfs:label": "DisplayBooking",
      "rdfs:subClassOf": {
        "@id": "schema:Schedule"
      },
      "rdfs:comment": "A banner placed in a display slot for an audience and a period. Used as additionalType on a Schedule."
    },
    {
      "@id": "acom:DrawRecord",
      "@type": "rdfs:Class",
      "rdfs:label": "DrawRecord",
      "rdfs:subClassOf": {
        "@id": "schema:ChooseAction"
      },
      "rdfs:comment": "A reproducible record of a prize draw: method, seed commitment, entrants, result. Used as additionalType on a ChooseAction."
    },
    {
      "@id": "acom:EventEntry",
      "@type": "rdfs:Class",
      "rdfs:label": "EventEntry",
      "rdfs:subClassOf": {
        "@id": "schema:JoinAction"
      },
      "rdfs:comment": "one entry of a member in an event, and whether it won. id prefix ent_."
    },
    {
      "@id": "acom:EventReward",
      "@type": "rdfs:Class",
      "rdfs:label": "EventReward",
      "rdfs:subClassOf": {
        "@id": "schema:Offer"
      },
      "rdfs:comment": "A prize for one rank of an event. Used as additionalType on an Offer."
    },
    {
      "@id": "acom:GiftOrder",
      "@type": "rdfs:Class",
      "rdfs:label": "GiftOrder",
      "rdfs:subClassOf": {
        "@id": "schema:AcceptAction"
      },
      "rdfs:comment": "a gift waiting for its recipient to accept it and give an address; id prefix gift_. API: gift_order."
    },
    {
      "@id": "acom:IdentityVerification",
      "@type": "rdfs:Class",
      "rdfs:label": "IdentityVerification",
      "rdfs:subClassOf": {
        "@id": "schema:CheckAction"
      },
      "rdfs:comment": "one identity check by a method from customer.yml identity_verification (one-time code, link, registry lookup). id prefix ivf_."
    },
    {
      "@id": "acom:InquirySummary",
      "@type": "rdfs:Class",
      "rdfs:label": "InquirySummary",
      "rdfs:subClassOf": {
        "@id": "schema:Observation"
      },
      "rdfs:comment": "one row per customer inquiry: the store day it came in, its type and state, when staff or the agent first answered and when it was resolved; never who asked or what they wrote."
    },
    {
      "@id": "acom:Lexicon",
      "@type": "rdfs:Class",
      "rdfs:label": "Lexicon",
      "rdfs:subClassOf": {
        "@id": "schema:DefinedTermSet"
      },
      "rdfs:comment": "one version of the store's search dictionary for one language: synonyms, new words and boost or exclude rules; a version takes effect when a reindex uses it. id prefix lex_."
    },
    {
      "@id": "acom:LoyaltyTransaction",
      "@type": "rdfs:Class",
      "rdfs:label": "LoyaltyTransaction",
      "rdfs:subClassOf": {
        "@id": "schema:MoneyTransfer"
      },
      "rdfs:comment": "one entry of a member's store-point ledger; entries are only added and the balance is their sum. id prefix lyt_."
    },
    {
      "@id": "acom:MemberCoupon",
      "@type": "rdfs:Class",
      "rdfs:label": "MemberCoupon",
      "rdfs:subClassOf": {
        "@id": "schema:OwnershipInfo"
      },
      "rdfs:comment": "A coupon issued to one member, with its own status and validity. Used as additionalType on OwnershipInfo."
    },
    {
      "@id": "acom:MessageTemplate",
      "@type": "rdfs:Class",
      "rdfs:label": "MessageTemplate",
      "rdfs:subClassOf": {
        "@id": "schema:CreativeWork"
      },
      "rdfs:comment": "a reusable message for one channel, with named variables; creating one sends nothing. id prefix tpl_."
    },
    {
      "@id": "acom:NewMembers",
      "@type": "rdfs:Class",
      "rdfs:label": "NewMembers",
      "rdfs:subClassOf": {
        "@id": "schema:Observation"
      },
      "rdfs:comment": "accounts created per store day, by the tier the members are in now."
    },
    {
      "@id": "acom:OrderLineSummary",
      "@type": "rdfs:Class",
      "rdfs:label": "OrderLineSummary",
      "rdfs:subClassOf": {
        "@id": "schema:OrderItem"
      },
      "rdfs:comment": "one row per line of the orders that count as sales (paid, not cancelled): day, variant, product, category, campaign, units and net amount, never who bought it."
    },
    {
      "@id": "acom:OrderSummary",
      "@type": "rdfs:Class",
      "rdfs:label": "OrderSummary",
      "rdfs:subClassOf": {
        "@id": "schema:Order"
      },
      "rdfs:comment": "one row per paid order with only what aggregates need (day, state, tier, campaign, amount, return request), never who placed it; orders still awaiting payment are left out."
    },
    {
      "@id": "acom:Preference",
      "@type": "rdfs:Class",
      "rdfs:label": "Preference",
      "rdfs:subClassOf": {
        "@id": "schema:PropertyValue"
      },
      "rdfs:comment": "Something the store remembers about a shopper, visible to the shopper and undoable. Used as additionalType on a PropertyValue."
    },
    {
      "@id": "acom:ProductImport",
      "@type": "rdfs:Class",
      "rdfs:label": "ProductImport",
      "rdfs:subClassOf": {
        "@id": "schema:CreateAction"
      },
      "rdfs:comment": "one batch_import run that turned a supplier sheet into product drafts. id prefix imp_. API: import_id."
    },
    {
      "@id": "acom:ProgramVersion",
      "@type": "rdfs:Class",
      "rdfs:label": "ProgramVersion",
      "rdfs:subClassOf": {
        "@id": "schema:MemberProgram"
      },
      "rdfs:comment": "one saved definition of a tier program (define_tier_program); earlier versions stay so a change can be undone."
    },
    {
      "@id": "acom:Promotion",
      "@type": "rdfs:Class",
      "rdfs:label": "Promotion",
      "rdfs:subClassOf": {
        "@id": "schema:OfferCatalog"
      },
      "rdfs:comment": "A set of sale prices for some products, for some shoppers, for a period. Used as additionalType on an OfferCatalog."
    },
    {
      "@id": "acom:RecoveryRequest",
      "@type": "rdfs:Class",
      "rdfs:label": "RecoveryRequest",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "a password reset or sign-in id request; made the same way whether an account matches or not. id prefix rcv_."
    },
    {
      "@id": "acom:Refund",
      "@type": "rdfs:Class",
      "rdfs:label": "Refund",
      "rdfs:subClassOf": {
        "@id": "schema:MoneyTransfer"
      },
      "rdfs:comment": "Money paid back to a shopper for a claim. Used as additionalType on a MoneyTransfer."
    },
    {
      "@id": "acom:ReindexJob",
      "@type": "rdfs:Class",
      "rdfs:label": "ReindexJob",
      "rdfs:subClassOf": {
        "@id": "schema:UpdateAction"
      },
      "rdfs:comment": "one rebuild of the store's search documents, whole or only what changed, with the dictionary version it used; the documents switch over when it commits. id prefix rij_."
    },
    {
      "@id": "acom:Remedy",
      "@type": "rdfs:Class",
      "rdfs:label": "Remedy",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "compensation for a customer (points, coupon or cash) with its liability and step-by-step approval. id prefix rmd_."
    },
    {
      "@id": "acom:Reorder",
      "@type": "rdfs:Class",
      "rdfs:label": "Reorder",
      "rdfs:subClassOf": {
        "@id": "schema:Order"
      },
      "rdfs:comment": "stock the store orders from its supplier for one product; id prefix ro_. API: reorder."
    },
    {
      "@id": "acom:RestockAlert",
      "@type": "rdfs:Class",
      "rdfs:label": "RestockAlert",
      "rdfs:subClassOf": {
        "@id": "schema:SubscribeAction"
      },
      "rdfs:comment": "a shopper asks to be told when a sold-out variant is back; a transactional alert, not marketing. id prefix rsa_."
    },
    {
      "@id": "acom:ReviewVote",
      "@type": "rdfs:Class",
      "rdfs:label": "ReviewVote",
      "rdfs:subClassOf": {
        "@id": "schema:VoteAction"
      },
      "rdfs:comment": "one shopper's helpful vote on a review; a review's helpful count is its rows with is_helpful true."
    },
    {
      "@id": "acom:Segment",
      "@type": "rdfs:Class",
      "rdfs:label": "Segment",
      "rdfs:subClassOf": {
        "@id": "schema:Audience"
      },
      "rdfs:comment": "A group of customers defined by conditions. Used as additionalType on an Audience."
    },
    {
      "@id": "acom:StockOut",
      "@type": "rdfs:Class",
      "rdfs:label": "StockOut",
      "rdfs:subClassOf": {
        "@id": "schema:Offer"
      },
      "rdfs:comment": "one row per variant that is out of stock now, with when it ran out and when it is expected back."
    },
    {
      "@id": "acom:Task",
      "@type": "rdfs:Class",
      "rdfs:label": "Task",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "Work proposed to an operator (by a person, an agent, or an automation), opened as a conversation. Used as additionalType on an Action."
    },
    {
      "@id": "acom:TierChange",
      "@type": "rdfs:Class",
      "rdfs:label": "TierChange",
      "rdfs:subClassOf": {
        "@id": "schema:UpdateAction"
      },
      "rdfs:comment": "one change of a member's tier, only ever added (list_tier_history). Keyed by member, program and position."
    },
    {
      "@id": "acom:TierCount",
      "@type": "rdfs:Class",
      "rdfs:label": "TierCount",
      "rdfs:subClassOf": {
        "@id": "schema:Observation"
      },
      "rdfs:comment": "members per tier now, leaving out blocked and withdrawn accounts."
    },
    {
      "@id": "acom:TierEvaluation",
      "@type": "rdfs:Class",
      "rdfs:label": "TierEvaluation",
      "rdfs:subClassOf": {
        "@id": "schema:AssessAction"
      },
      "rdfs:comment": "one run of a program's tier evaluation and the moves it made. id prefix tev_. API: evaluation_id."
    },
    {
      "@id": "acom:TierRequirement",
      "@type": "rdfs:Class",
      "rdfs:label": "TierRequirement",
      "rdfs:subClassOf": {
        "@id": "schema:StructuredValue"
      },
      "rdfs:comment": "What a member must reach to hold a tier (spend, order count, points) over a window."
    },
    {
      "@id": "acom:WishlistItem",
      "@type": "rdfs:Class",
      "rdfs:label": "WishlistItem",
      "rdfs:subClassOf": {
        "@id": "schema:ListItem"
      },
      "rdfs:comment": "one product a shopper keeps for later; the product id names the item, there is no id of its own."
    },
    {
      "@id": "acom:Withdrawal",
      "@type": "rdfs:Class",
      "rdfs:label": "Withdrawal",
      "rdfs:subClassOf": {
        "@id": "schema:Action"
      },
      "rdfs:comment": "a member leaving the store: why, what was settled, what is kept and until when, and the one-way fingerprints that block rejoining and id reuse for a while."
    },
    {
      "@id": "acom:acceptedAt",
      "@type": "rdf:Property",
      "rdfs:label": "acceptedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:GiftOrder"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the recipient accepted and gave the address; NULL until then."
    },
    {
      "@id": "acom:actionType",
      "@type": "rdf:Property",
      "rdfs:label": "actionType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the schema.org Action subtype (@type), for example UpdateAction."
    },
    {
      "@id": "acom:actorKind",
      "@type": "rdf:Property",
      "rdfs:label": "actorKind",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ActorKind"
        }
      ],
      "rdfs:comment": "kind of principal that acted. values: actor_kind"
    },
    {
      "@id": "acom:adminId",
      "@type": "rdf:Property",
      "rdfs:label": "adminId",
      "schema:domainIncludes": [
        {
          "@id": "schema:Conversation"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "operator in the conversation (adm_ id), NULL on fo; plain text like customer_id."
    },
    {
      "@id": "acom:adminStatus",
      "@type": "rdf:Property",
      "rdfs:label": "adminStatus",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:AdminStatus"
        }
      ],
      "rdfs:comment": "whether the account can sign in. values: admin_status"
    },
    {
      "@id": "acom:agentProfile",
      "@type": "rdf:Property",
      "rdfs:label": "agentProfile",
      "schema:domainIncludes": [
        {
          "@id": "schema:Conversation"
        },
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "specialized agent that handled the turn."
    },
    {
      "@id": "acom:aiGenerated",
      "@type": "rdf:Property",
      "rdfs:label": "aiGenerated",
      "schema:domainIncludes": [
        {
          "@id": "acom:CopyDraft"
        },
        {
          "@id": "schema:ImageObject"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true for generated content (catalog.yml content.ai_content_disclosure)."
    },
    {
      "@id": "acom:amount",
      "@type": "rdf:Property",
      "rdfs:label": "amount",
      "schema:domainIncludes": [
        {
          "@id": "acom:Remedy"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 currency of amount_value."
    },
    {
      "@id": "acom:amountOff",
      "@type": "rdf:Property",
      "rdfs:label": "amountOff",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 code of amount_off_value."
    },
    {
      "@id": "acom:analyzerVersion",
      "@type": "rdf:Property",
      "rdfs:label": "analyzerVersion",
      "schema:domainIncludes": [
        {
          "@id": "acom:Lexicon"
        },
        {
          "@id": "acom:ReindexJob"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "dictionary version the index uses from this job on (search.lexicon, or v1 for the policy default)."
    },
    {
      "@id": "acom:announceAt",
      "@type": "rdf:Property",
      "rdfs:label": "announceAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when winners are announced; NULL when not planned."
    },
    {
      "@id": "acom:apiKeyStatus",
      "@type": "rdf:Property",
      "rdfs:label": "apiKeyStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:ApiKey"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ApiKeyStatus"
        }
      ],
      "rdfs:comment": "whether the key can still sign in. values: api_key_status"
    },
    {
      "@id": "acom:appliesTo",
      "@type": "rdf:Property",
      "rdfs:label": "appliesTo",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "scope: {scope: products, categories or order, product_ids[], category_ids[], exclude_product_ids[]}."
