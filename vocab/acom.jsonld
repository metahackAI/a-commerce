    {
      "@id": "acom:loginId",
      "@type": "rdf:Property",
      "rdfs:label": "loginId",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "what the operator types to sign in (for example admin); NULL means the account cannot sign in with a password."
