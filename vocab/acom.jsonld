    {
      "@id": "acom:liability",
      "@type": "rdf:Property",
      "rdfs:label": "liability",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        },
        {
          "@id": "schema:CheckAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:Liability"
        }
      ],
