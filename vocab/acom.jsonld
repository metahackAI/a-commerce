      "@id": "acom:outputTokens",
      "@type": "rdf:Property",
      "rdfs:label": "outputTokens",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "tokens received."
    },
    {
      "@id": "acom:page",
      "@type": "rdf:Property",
      "rdfs:label": "page",
      "schema:domainIncludes": [
        {
          "@id": "schema:WebPageElement"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "page the slot is on: main, category, product or search (list_display_slots page values)."
    },
