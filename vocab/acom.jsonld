      "@id": "acom:paidAt",
      "@type": "rdf:Property",
      "rdfs:label": "paidAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Remedy"
        },
        {
          "@id": "schema:PayAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the payment completed."
    },
