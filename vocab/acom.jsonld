      "rdfs:label": "ctaLabel",
      "schema:domainIncludes": [
        {
          "@id": "acom:Banner"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "button text, up to 24 characters."
    },
    {
      "@id": "acom:dataRetention",
      "@type": "rdf:Property",
      "rdfs:label": "dataRetention",
      "schema:domainIncludes": [
        {
          "@id": "acom:Withdrawal"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "what is kept and until when: [{data, until, why}]."
    },
    {
      "@id": "acom:decidedAt",
      "@type": "rdf:Property",
      "rdfs:label": "decidedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Remedy"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when it was approved or rejected; NULL until decided."
    },
    {
      "@id": "acom:decidedBy",
      "@type": "rdf:Property",
      "rdfs:label": "decidedBy",
      "schema:domainIncludes": [
        {
          "@id": "acom:Remedy"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "who approved or rejected it (the approving person's id); NULL until decided."
    },
    {
      "@id": "acom:decisionReason",
      "@type": "rdf:Property",
      "rdfs:label": "decisionReason",
      "schema:domainIncludes": [
        {
          "@id": "acom:Remedy"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "why it was rejected; NULL otherwise."
    },
    {
      "@id": "acom:definedAt",
      "@type": "rdf:Property",
      "rdfs:label": "definedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:ProgramVersion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when this version took effect (store clock)."
    },
    {
      "@id": "acom:definition",
      "@type": "rdf:Property",
      "rdfs:label": "definition",
      "schema:domainIncludes": [
        {
          "@id": "acom:ProgramVersion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "the whole definition: {name, evaluation, movement, has_tiers[]}."
    },
    {
      "@id": "acom:deliveredAt",
      "@type": "rdf:Property",
      "rdfs:label": "deliveredAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:ParcelDelivery"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the carrier reported delivery; return windows count from it."
    },
    {
      "@id": "acom:deliveryAddressId",
      "@type": "rdf:Property",
      "rdfs:label": "deliveryAddressId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Cart"
        },
        {
          "@id": "schema:ParcelDelivery"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:PostalAddress"
        }
      ],
      "rdfs:comment": "saved address used for delivery estimates (adr_ id)."
    },
    {
      "@id": "acom:deliveryState",
      "@type": "rdf:Property",
      "rdfs:label": "deliveryState",
      "schema:domainIncludes": [
        {
          "@id": "schema:ParcelDelivery"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:DeliveryState"
        }
      ],
      "rdfs:comment": "Where a parcel is."
    },
    {
      "@id": "acom:dependsOn",
      "@type": "rdf:Property",
      "rdfs:label": "dependsOn",
      "schema:domainIncludes": [
        {
          "@id": "schema:ListItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "preview ids whose results this item consumes, for example a promotion_id placeholder."
    },
    {
      "@id": "acom:destination",
      "@type": "rdf:Property",
      "rdfs:label": "destination",
      "schema:domainIncludes": [
        {
          "@id": "acom:IdentityVerification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the email or phone number the code or link goes to; NULL for registry lookups."
    },
    {
      "@id": "acom:discountLayer",
      "@type": "rdf:Property",
      "rdfs:label": "discountLayer",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        },
        {
          "@id": "schema:Offer"
        },
        {
          "@id": "schema:UnitPriceSpecification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:DiscountLayer"
        }
      ],
      "rdfs:comment": "Where a discount applies: item price, order, or add-on."
    },
    {
      "@id": "acom:discountLimit",
      "@type": "rdf:Property",
      "rdfs:label": "discountLimit",
      "schema:domainIncludes": [
        {
          "@id": "schema:EmployeeRole"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 currency of discount_limit_value."
    },
    {
      "@id": "acom:discountLimitPeriod",
      "@type": "rdf:Property",
      "rdfs:label": "discountLimitPeriod",
      "schema:domainIncludes": [
        {
          "@id": "schema:EmployeeRole"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:DiscountLimitPeriod"
        }
      ],
      "rdfs:comment": "the period the limit renews over. values: discount_limit_period"
    },
    {
      "@id": "acom:dispatchAt",
      "@type": "rdf:Property",
      "rdfs:label": "dispatchAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when rewards are sent; NULL when not planned."
    },
    {
      "@id": "acom:dispatchedAt",
      "@type": "rdf:Property",
      "rdfs:label": "dispatchedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventReward"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when it was sent; NULL while held or pending."
    },
    {
      "@id": "acom:displayCategory",
      "@type": "rdf:Property",
      "rdfs:label": "displayCategory",
      "schema:domainIncludes": [
        {
          "@id": "acom:CategoryMapping"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DefinedTerm"
        }
      ],
      "rdfs:comment": "the shopper menu category that shows them (cat_ id, term set display)."
    },
    {
      "@id": "acom:displayStatus",
      "@type": "rdf:Property",
      "rdfs:label": "displayStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:DisplayBooking"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:DisplayStatus"
        }
      ],
      "rdfs:comment": "Where a display booking is in its life."
    },
    {
      "@id": "acom:displayValidFrom",
      "@type": "rdf:Property",
      "rdfs:label": "displayValidFrom",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when shoppers start seeing the event; NULL means from start_date."
    },
    {
      "@id": "acom:displayValidThrough",
      "@type": "rdf:Property",
      "rdfs:label": "displayValidThrough",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when shoppers stop seeing it; NULL means until end_date."
    },
    {
      "@id": "acom:documentCount",
      "@type": "rdf:Property",
      "rdfs:label": "documentCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:ReindexJob"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "search documents written."
    },
    {
      "@id": "acom:draftNote",
      "@type": "rdf:Property",
      "rdfs:label": "draftNote",
      "schema:domainIncludes": [
        {
          "@id": "schema:DataFeedItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "one sentence for the person about what is open, for example Fabric mix is missing in the sheet; NULL when nothing is."
    },
    {
      "@id": "acom:draftStatus",
      "@type": "rdf:Property",
      "rdfs:label": "draftStatus",
      "schema:domainIncludes": [
        {
          "@id": "schema:DataFeedItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:DraftStatus"
        }
      ],
      "rdfs:comment": "whether the draft is complete or waits for a person. values: draft_status"
    },
    {
      "@id": "acom:drawAt",
      "@type": "rdf:Property",
      "rdfs:label": "drawAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the draw is planned; NULL when not planned."
    },
    {
      "@id": "acom:drawMode",
      "@type": "rdf:Property",
      "rdfs:label": "drawMode",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "what the run did, one of promotion.yml event.draw.modes: draw, redraw, cancel_winner, promote_waitlist, add_waitlist or manual_select."
    },
    {
      "@id": "acom:drawPosition",
      "@type": "rdf:Property",
      "rdfs:label": "drawPosition",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "which run of the event's draws this is, from 1; part of the shuffle key."
    },
    {
      "@id": "acom:drawRecordId",
      "@type": "rdf:Property",
      "rdfs:label": "drawRecordId",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "draw that last decided the entry (drw_ id); NULL for instant results."
    },
    {
      "@id": "acom:dueAt",
      "@type": "rdf:Property",
      "rdfs:label": "dueAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Task"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when it should be done, if a watcher sets one."
    },
    {
      "@id": "acom:effectiveAt",
      "@type": "rdf:Property",
      "rdfs:label": "effectiveAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Withdrawal"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the withdrawal took effect (store clock)."
    },
    {
      "@id": "acom:eligibility",
      "@type": "rdf:Property",
      "rdfs:label": "eligibility",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "who may enter: {valid_for_member_tier, segment_id, member_types[], purchase_condition: {min_subtotal, window, scope}, channels[]}."
    },
    {
      "@id": "acom:emailVerifiedAt",
      "@type": "rdf:Property",
      "rdfs:label": "emailVerifiedAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the member proved they own the email; NULL when it was never verified. Recovery links go only to verified contacts."
    },
    {
      "@id": "acom:employeeNumber",
      "@type": "rdf:Property",
      "rdfs:label": "employeeNumber",
      "schema:domainIncludes": [
        {
          "@id": "schema:EmployeeRole"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the store's own number for the employee, unique in the store."
    },
    {
      "@id": "acom:endedAt",
      "@type": "rdf:Property",
      "rdfs:label": "endedAt",
      "rdfs:subPropertyOf": {
        "@id": "schema:endTime"
      },
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        },
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "When the step, turn, or job ended."
    },
    {
      "@id": "acom:entrantCount",
      "@type": "rdf:Property",
      "rdfs:label": "entrantCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "how many entries the draw chose from."
    },
    {
      "@id": "acom:entrantSnapshotDigest",
      "@type": "rdf:Property",
      "rdfs:label": "entrantSnapshotDigest",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "sha256 of the entry ids the draw chose from, in order."
    },
    {
      "@id": "acom:entryConsent",
      "@type": "rdf:Property",
      "rdfs:label": "entryConsent",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "consents given when entering, {consent type: true}."
    },
    {
      "@id": "acom:entryId",
      "@type": "rdf:Property",
      "rdfs:label": "entryId",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventReward"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "rdfs:comment": "winning entry (ent_ id)."
    },
    {
      "@id": "acom:entryLimit",
      "@type": "rdf:Property",
      "rdfs:label": "entryLimit",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "entries one member may make: {count, period: day, week, event or unlimited}."
    },
    {
      "@id": "acom:entryMechanic",
      "@type": "rdf:Property",
      "rdfs:label": "entryMechanic",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "how shoppers enter, an id of the store registry promotion.yml event.entry_mechanics, for example check_in."
    },
    {
      "@id": "acom:entryNumber",
      "@type": "rdf:Property",
      "rdfs:label": "entryNumber",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "which entry of the member in that period it is, from 1."
    },
    {
      "@id": "acom:entryPayload",
      "@type": "rdf:Property",
      "rdfs:label": "entryPayload",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "what the member sent, following the event's entry_payload_schema (answers, a caption, a code)."
    },
    {
      "@id": "acom:entryPayloadSchema",
      "@type": "rdf:Property",
      "rdfs:label": "entryPayloadSchema",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "fields an entry must send, {field: type}; NULL when an entry needs no data."
    },
    {
      "@id": "acom:entryStatus",
      "@type": "rdf:Property",
      "rdfs:label": "entryStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventEntry"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:EntryStatus"
        }
      ],
      "rdfs:comment": "entered until a draw or an instant result decides it. values: entry_status"
    },
    {
      "@id": "acom:estimatedAt",
      "@type": "rdf:Property",
      "rdfs:label": "estimatedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Segment"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "store-clock time estimated_size was counted."
    },
    {
      "@id": "acom:estimatedSize",
      "@type": "rdf:Property",
      "rdfs:label": "estimatedSize",
      "schema:domainIncludes": [
        {
          "@id": "acom:Segment"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "how many active members matched when the segment was last defined."
    },
    {
      "@id": "acom:evaluation",
      "@type": "rdf:Property",
      "rdfs:label": "evaluation",
      "schema:domainIncludes": [
        {
          "@id": "schema:MemberProgram"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "when tiers are evaluated: {schedule: {every, on_day, at}, on_event[], settle_days}."
    },
    {
      "@id": "acom:evaluationId",
      "@type": "rdf:Property",
      "rdfs:label": "evaluationId",
      "schema:domainIncludes": [
        {
          "@id": "acom:TierChange"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:TierEvaluation"
        }
      ],
      "rdfs:comment": "the evaluation run that made the change (tev_ id); NULL for other causes."
    },
    {
      "@id": "acom:eventId",
      "@type": "rdf:Property",
      "rdfs:label": "eventId",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventReward"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "rdfs:comment": "event the reward belongs to (evt_ id)."
    },
    {
      "@id": "acom:eventStatus",
      "@type": "rdf:Property",
      "rdfs:label": "eventStatus",
      "schema:domainIncludes": [
        {
          "@id": "schema:Event"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:EventStatus"
        }
      ],
      "rdfs:comment": "stored status; scheduled and running follow the entry period and the store clock, closed after it ends. values: event_status"
    },
    {
      "@id": "acom:evidence",
      "@type": "rdf:Property",
      "rdfs:label": "evidence",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "photos and documents attached: [{id, evidence_type, content_url}], evd_ ids."
    },
    {
      "@id": "acom:excluded",
      "@type": "rdf:Property",
      "rdfs:label": "excluded",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "entries left out and why: {previous_winners, invalid_entries}."
    },
    {
      "@id": "acom:expiresAt",
      "@type": "rdf:Property",
      "rdfs:label": "expiresAt",
      "rdfs:subPropertyOf": {
        "@id": "schema:expires"
      },
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "When this stops being valid (a preview, a session, an idempotency record)."
    },
    {
      "@id": "acom:externalId",
      "@type": "rdf:Property",
      "rdfs:label": "externalId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Refund"
        },
        {
          "@id": "schema:PayAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the payment provider's reference."
    },
    {
      "@id": "acom:eyebrow",
      "@type": "rdf:Property",
      "rdfs:label": "eyebrow",
      "schema:domainIncludes": [
        {
          "@id": "acom:Banner"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "small header above the headline, up to 24 characters."
    },
    {
      "@id": "acom:failedPasswordAttempts",
      "@type": "rdf:Property",
      "rdfs:label": "failedPasswordAttempts",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "wrong passwords since first_failed_password_at, counted for password.lockout."
    },
    {
      "@id": "acom:featureFlags",
      "@type": "rdf:Property",
      "rdfs:label": "featureFlags",
      "schema:domainIncludes": [
        {
          "@id": "schema:OnlineStore"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "features switched on for this store, as {flag: true|false}; {} when none."
    },
    {
      "@id": "acom:firstFailedPasswordAt",
      "@type": "rdf:Property",
      "rdfs:label": "firstFailedPasswordAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "the first wrong password of the current lockout window; NULL when there is none."
    },
    {
      "@id": "acom:firstResponseTime",
      "@type": "rdf:Property",
      "rdfs:label": "firstResponseTime",
      "schema:domainIncludes": [
        {
          "@id": "acom:InquirySummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "when staff or the agent first wrote in the thread; NULL while nobody has."
    },
    {
      "@id": "acom:fitVote",
      "@type": "rdf:Property",
      "rdfs:label": "fitVote",
      "schema:domainIncludes": [
        {
          "@id": "schema:Review"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:FitVote"
        }
      ],
      "rdfs:comment": "how the size fit; NULL when the reviewer did not say. values: fit_vote"
    },
    {
      "@id": "acom:fromState",
      "@type": "rdf:Property",
      "rdfs:label": "fromState",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ChangeSetState"
        },
        {
          "@id": "acom:ClaimStatus"
        },
        {
          "@id": "schema:OrderStatus"
        }
      ],
      "rdfs:comment": "state before the event; NULL for the creating event. values: claim_status"
    },
    {
      "@id": "acom:fromTierId",
      "@type": "rdf:Property",
      "rdfs:label": "fromTierId",
      "schema:domainIncludes": [
        {
          "@id": "acom:TierChange"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the tier before; NULL when the member entered the program. Not a foreign key: history outlives deleted tiers."
    },
    {
      "@id": "acom:fulfillment",
      "@type": "rdf:Property",
      "rdfs:label": "fulfillment",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventReward"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "how it is sent: ship, issue, grant, email or manual (promotion.yml event.reward_types.fulfillment_methods)."
    },
    {
      "@id": "acom:fulfillmentRef",
      "@type": "rdf:Property",
      "rdfs:label": "fulfillmentRef",
      "schema:domainIncludes": [
        {
          "@id": "acom:EventReward"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "what sending made: a member coupon (mcp_), a ledger entry (lyt_), or the reference of a stubbed shipment or email."
    },
    {
      "@id": "acom:fulfillmentStage",
      "@type": "rdf:Property",
      "rdfs:label": "fulfillmentStage",
      "schema:domainIncludes": [
        {
          "@id": "schema:OrderItem"
        },
        {
          "@id": "schema:ParcelDelivery"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:FulfillmentStage"
        }
      ],
      "rdfs:comment": "The warehouse step of an order item or delivery."
    },
    {
      "@id": "acom:giftOptions",
      "@type": "rdf:Property",
      "rdfs:label": "giftOptions",
      "schema:domainIncludes": [
        {
          "@id": "schema:Order"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "{card_message, gift_receipt, exchange_until} for gift orders."
    },
    {
      "@id": "acom:giftTiers",
      "@type": "rdf:Property",
      "rdfs:label": "giftTiers",
      "schema:domainIncludes": [
        {
          "@id": "acom:ConditionalGift"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "thresholds in ascending order, each with its gift: [{trigger_threshold: {value, currency}, gift_product_id}]."
    },
    {
      "@id": "acom:giftWrap",
      "@type": "rdf:Property",
      "rdfs:label": "giftWrap",
      "schema:domainIncludes": [
        {
          "@id": "schema:Order"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 code of gift_wrap_value."
    },
    {
      "@id": "acom:granted",
      "@type": "rdf:Property",
      "rdfs:label": "granted",
      "schema:domainIncludes": [
        {
          "@id": "acom:ConsentRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when consent was given, false when it was withdrawn."
    },
    {
      "@id": "acom:hasReturnRequest",
      "@type": "rdf:Property",
      "rdfs:label": "hasReturnRequest",
      "schema:domainIncludes": [
        {
          "@id": "acom:OrderSummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "true when a return was asked for on the order and not declined or withdrawn."
    },
    {
      "@id": "acom:identifierReusableAfter",
      "@type": "rdf:Property",
      "rdfs:label": "identifierReusableAfter",
      "schema:domainIncludes": [
        {
          "@id": "acom:Withdrawal"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "the email and sign-in id can be used again from this time; NULL when never (withdrawal.identifier_reuse)."
    },
    {
      "@id": "acom:imageColor",
      "@type": "rdf:Property",
      "rdfs:label": "imageColor",
      "schema:domainIncludes": [
        {
          "@id": "acom:Banner"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "color variant of image_product_group_id to photograph, for example Sand."
    },
    {
      "@id": "acom:imageProduct",
      "@type": "rdf:Property",
      "rdfs:label": "imageProduct",
      "schema:domainIncludes": [
        {
          "@id": "acom:Banner"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:ProductGroup"
        }
      ],
      "rdfs:comment": "product whose main image the banner shows (prd_ id)."
    },
    {
      "@id": "acom:imageStyle",
      "@type": "rdf:Property",
      "rdfs:label": "imageStyle",
      "schema:domainIncludes": [
        {
          "@id": "schema:ImageObject"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ImageStyle"
        }
      ],
      "rdfs:comment": "how the image is staged. values: image_style"
    },
    {
      "@id": "acom:importMode",
      "@type": "rdf:Property",
      "rdfs:label": "importMode",
      "schema:domainIncludes": [
        {
          "@id": "acom:ProductImport"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ImportMode"
        }
      ],
      "rdfs:comment": "create makes new drafts only; upsert also refreshes drafts an earlier import made. values: import_mode"
    },
    {
      "@id": "acom:input",
      "@type": "rdf:Property",
      "rdfs:label": "input",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "normalized operation input."
    },
    {
      "@id": "acom:inputTokens",
      "@type": "rdf:Property",
      "rdfs:label": "inputTokens",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "tokens sent."
    },
    {
      "@id": "acom:inquiryId",
      "@type": "rdf:Property",
      "rdfs:label": "inquiryId",
      "schema:domainIncludes": [
        {
          "@id": "acom:InquirySummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the inquiry (inq_ id)."
    },
    {
      "@id": "acom:inquiryStatus",
      "@type": "rdf:Property",
      "rdfs:label": "inquiryStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:CustomerInquiry"
        },
        {
          "@id": "acom:InquirySummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:InquiryStatus"
        }
      ],
      "rdfs:comment": "where the inquiry is now. values: inquiry_status"
    },
    {
      "@id": "acom:inquiryType",
      "@type": "rdf:Property",
      "rdfs:label": "inquiryType",
      "schema:domainIncludes": [
        {
          "@id": "acom:CustomerInquiry"
        },
        {
          "@id": "acom:InquirySummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:InquiryType"
        }
      ],
      "rdfs:comment": "what the inquiry is about. values: inquiry_type"
    },
    {
      "@id": "acom:inspectionCondition",
      "@type": "rdf:Property",
      "rdfs:label": "inspectionCondition",
      "schema:domainIncludes": [
        {
          "@id": "schema:CheckAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:InspectionCondition"
        }
      ],
      "rdfs:comment": "Condition of a returned item after inspection."
    },
    {
      "@id": "acom:installmentMonths",
      "@type": "rdf:Property",
      "rdfs:label": "installmentMonths",
      "schema:domainIncludes": [
        {
          "@id": "schema:PayAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "card installments, 0 means paid at once."
    },
    {
      "@id": "acom:interpretation",
      "@type": "rdf:Property",
      "rdfs:label": "interpretation",
      "schema:domainIncludes": [
        {
          "@id": "acom:ChangeSet"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "how the runtime understood the request: [{slot, text, value}], slot is who, products, benefit, when, where or other."
    },
    {
      "@id": "acom:invalidatedAt",
      "@type": "rdf:Property",
      "rdfs:label": "invalidatedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:RecoveryRequest"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when a newer request or too many wrong codes made it stop working."
    },
    {
      "@id": "acom:inventoryCost",
      "@type": "rdf:Property",
      "rdfs:label": "inventoryCost",
      "schema:domainIncludes": [
        {
          "@id": "schema:Offer"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "What one unit costs the store. Visible to operators only; used for price floors."
    },
    {
      "@id": "acom:isActive",
      "@type": "rdf:Property",
      "rdfs:label": "isActive",
      "schema:domainIncludes": [
        {
          "@id": "schema:DefinedTerm"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "false hides the category and its children."
    },
    {
      "@id": "acom:isBestseller",
      "@type": "rdf:Property",
      "rdfs:label": "isBestseller",
      "schema:domainIncludes": [
        {
          "@id": "acom:StockOut"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "true when the store tags the product bestseller (catalog keywords)."
    },
    {
      "@id": "acom:isHelpful",
      "@type": "rdf:Property",
      "rdfs:label": "isHelpful",
      "schema:domainIncludes": [
        {
          "@id": "acom:ReviewVote"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true while the shopper marks the review helpful; false after they take the vote back."
    },
    {
      "@id": "acom:isPinned",
      "@type": "rdf:Property",
      "rdfs:label": "isPinned",
      "schema:domainIncludes": [
        {
          "@id": "schema:NewsArticle"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "shown above the other notices."
    },
    {
      "@id": "acom:isPrimary",
      "@type": "rdf:Property",
      "rdfs:label": "isPrimary",
      "schema:domainIncludes": [
        {
          "@id": "acom:CategoryMapping"
        },
        {
          "@id": "acom:CategoryPlacement"
        },
        {
          "@id": "schema:PostalAddress"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "the shopper's main address; at most one per shopper."
    },
    {
      "@id": "acom:isPrivate",
      "@type": "rdf:Property",
      "rdfs:label": "isPrivate",
      "schema:domainIncludes": [
        {
          "@id": "schema:Question"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when only the asker and the store may read it (catalog.yml question.private_allowed)."
    },
    {
      "@id": "acom:isSystem",
      "@type": "rdf:Property",
      "rdfs:label": "isSystem",
      "schema:domainIncludes": [
        {
          "@id": "schema:Role"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true for built-in roles that cannot be edited."
    },
    {
      "@id": "acom:isVisible",
      "@type": "rdf:Property",
      "rdfs:label": "isVisible",
      "schema:domainIncludes": [
        {
          "@id": "schema:SiteNavigationElement"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "false hides the entry from every operator without removing it."
    },
    {
      "@id": "acom:keyPrefix",
      "@type": "rdf:Property",
      "rdfs:label": "keyPrefix",
      "schema:domainIncludes": [
        {
          "@id": "acom:ApiKey"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the first characters of the secret, shown in lists so people can recognize a key."
    },
    {
      "@id": "acom:label",
      "@type": "rdf:Property",
      "rdfs:label": "label",
      "rdfs:subPropertyOf": {
        "@id": "schema:name"
      },
      "schema:domainIncludes": [
        {
          "@id": "schema:PostalAddress"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "A short name the owner gave this (for example an address called Home)."
    },
    {
      "@id": "acom:lastLoginAt",
      "@type": "rdf:Property",
      "rdfs:label": "lastLoginAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "last successful sign-in; NULL if never."
    },
    {
      "@id": "acom:lastTurnAt",
      "@type": "rdf:Property",
      "rdfs:label": "lastTurnAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Conversation"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "latest turn."
    },
    {
      "@id": "acom:lastUsedAt",
      "@type": "rdf:Property",
      "rdfs:label": "lastUsedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:ApiKey"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "the last successful sign-in with the key; NULL if never."
    },
    {
      "@id": "acom:latency",
      "@type": "rdf:Property",
      "rdfs:label": "latency",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "time the call took, in milliseconds."
    },
    {
      "@id": "acom:learnedAt",
      "@type": "rdf:Property",
      "rdfs:label": "learnedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:Preference"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when it was remembered."
    },
    {
      "@id": "acom:liability",
      "@type": "rdf:Property",
      "rdfs:label": "liability",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        },
        {
          "@id": "acom:Remedy"
        },
        {
          "@id": "schema:CheckAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:Liability"
        }
      ],
      "rdfs:comment": "Who is responsible, which decides who pays."
    },
    {
      "@id": "acom:lockedUntil",
      "@type": "rdf:Property",
      "rdfs:label": "lockedUntil",
      "schema:domainIncludes": [
        {
          "@id": "acom:ApiKey"
        },
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "sign-in is refused until then after too many wrong secrets; NULL when not locked."
    },
    {
      "@id": "acom:loginId",
      "@type": "rdf:Property",
      "rdfs:label": "loginId",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the id the member signs in with besides the email; NULL when they sign in with the email only."
    },
    {
      "@id": "acom:loyaltyTransactionType",
      "@type": "rdf:Property",
      "rdfs:label": "loyaltyTransactionType",
      "schema:domainIncludes": [
        {
          "@id": "acom:LoyaltyTransaction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:LoyaltyTransactionType"
        }
      ],
      "rdfs:comment": "accrual, grant and restore add points; spend, expire and reversal take them away. values: loyalty_transaction_type"
    },
    {
      "@id": "acom:managed",
      "@type": "rdf:Property",
      "rdfs:label": "managed",
      "schema:domainIncludes": [
        {
          "@id": "schema:Product"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when stock is tracked and can run out."
    },
    {
      "@id": "acom:memberCount",
      "@type": "rdf:Property",
      "rdfs:label": "memberCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:NewMembers"
        },
        {
          "@id": "acom:TierCount"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "members in the tier now."
    },
    {
      "@id": "acom:memberState",
      "@type": "rdf:Property",
      "rdfs:label": "memberState",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MemberState"
        }
      ],
      "rdfs:comment": "Whether a member can use the store."
    },
    {
      "@id": "acom:memberType",
      "@type": "rdf:Property",
      "rdfs:label": "memberType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MemberType"
        }
      ],
      "rdfs:comment": "individual or business member. values: member_type"
    },
    {
      "@id": "acom:messageChannel",
      "@type": "rdf:Property",
      "rdfs:label": "messageChannel",
      "schema:domainIncludes": [
        {
          "@id": "acom:Campaign"
        },
        {
          "@id": "acom:CampaignSend"
        },
        {
          "@id": "acom:MessageTemplate"
        },
        {
          "@id": "acom:RecoveryRequest"
        },
        {
          "@id": "acom:RestockAlert"
        },
        {
          "@id": "schema:Comment"
        },
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MessageChannel"
        }
      ],
      "rdfs:comment": "channel it is sent on. values: message_channel"
    },
    {
      "@id": "acom:messageKind",
      "@type": "rdf:Property",
      "rdfs:label": "messageKind",
      "schema:domainIncludes": [
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MessageKind"
        }
      ],
      "rdfs:comment": "what the message does. values: message_kind"
    },
    {
      "@id": "acom:messagePurpose",
      "@type": "rdf:Property",
      "rdfs:label": "messagePurpose",
      "schema:domainIncludes": [
        {
          "@id": "acom:MessageTemplate"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "marketing (needs opt-in consent, held in quiet hours) or transactional (about an order or claim)."
    },
    {
      "@id": "acom:method",
      "@type": "rdf:Property",
      "rdfs:label": "method",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "how winners were chosen, from promotion.yml event.draw.fairness.method, for example seeded_shuffle."
    },
    {
      "@id": "acom:model",
      "@type": "rdf:Property",
      "rdfs:label": "model",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "model name, for example muse-glimmer-30b."
    },
    {
      "@id": "acom:movement",
      "@type": "rdf:Property",
      "rdfs:label": "movement",
      "schema:domainIncludes": [
        {
          "@id": "schema:MemberProgram"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "how members move: {upgrade, downgrade, max_steps_down, grace_periods}."
    },
