    {
      "@id": "acom:managed",
      "@type": "rdf:Property",
      "rdfs:label": "managed",
      "schema:domainIncludes": [
        {
          "@id": "schema:Product"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when stock is tracked and can run out."
    },
    {
      "@id": "acom:memberCount",
      "@type": "rdf:Property",
      "rdfs:label": "memberCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:NewMembers"
        },
        {
          "@id": "acom:TierCount"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "members in the tier now."
    },
    {
      "@id": "acom:memberState",
      "@type": "rdf:Property",
      "rdfs:label": "memberState",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MemberState"
        }
      ],
      "rdfs:comment": "Whether a member can use the store."
    },
    {
      "@id": "acom:memberType",
      "@type": "rdf:Property",
      "rdfs:label": "memberType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MemberType"
        }
      ],
      "rdfs:comment": "individual or business member. values: member_type"
    },
    {
      "@id": "acom:messageChannel",
      "@type": "rdf:Property",
      "rdfs:label": "messageChannel",
      "schema:domainIncludes": [
        {
          "@id": "acom:Campaign"
        },
        {
          "@id": "acom:CampaignSend"
        },
        {
          "@id": "acom:MessageTemplate"
        },
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MessageChannel"
        }
      ],
      "rdfs:comment": "channel it is sent on. values: message_channel"
    },
    {
      "@id": "acom:messageKind",
      "@type": "rdf:Property",
      "rdfs:label": "messageKind",
      "schema:domainIncludes": [
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:MessageKind"
        }
      ],
      "rdfs:comment": "what the message does. values: message_kind"
    },
    {
      "@id": "acom:messagePurpose",
      "@type": "rdf:Property",
      "rdfs:label": "messagePurpose",
      "schema:domainIncludes": [
        {
          "@id": "acom:MessageTemplate"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "marketing (needs opt-in consent, held in quiet hours) or transactional (about an order or claim)."
    },
    {
      "@id": "acom:model",
      "@type": "rdf:Property",
      "rdfs:label": "model",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "model name, for example muse-glimmer-30b."
    },
    {
      "@id": "acom:movement",
      "@type": "rdf:Property",
      "rdfs:label": "movement",
      "schema:domainIncludes": [
        {
          "@id": "schema:MemberProgram"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "how members move: {upgrade, downgrade, max_steps_down, grace_periods}."
    },
    {
      "@id": "acom:needsApproval",
      "@type": "rdf:Property",
      "rdfs:label": "needsApproval",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when only an approved change set may run it."
    },
    {
      "@id": "acom:number",
      "@type": "rdf:Property",
      "rdfs:label": "number",
      "rdfs:subPropertyOf": {
        "@id": "schema:identifier"
      },
      "schema:domainIncludes": [
        {
          "@id": "acom:ChangeSet"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "The number people see, such as change set 1042."
    },
    {
      "@id": "acom:objectType",
      "@type": "rdf:Property",
      "rdfs:label": "objectType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "schema.org type of the object, for example Offer."
    },
    {
      "@id": "acom:offerId",
      "@type": "rdf:Property",
      "rdfs:label": "offerId",
      "schema:domainIncludes": [
        {
          "@id": "schema:UnitPriceSpecification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Offer"
        }
      ],
      "rdfs:comment": "offer the price applies to (off_ id); the Offer's priceSpecification."
    },
    {
      "@id": "acom:operation",
      "@type": "rdf:Property",
      "rdfs:label": "operation",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "logical address of the write, for example promotion.offer.set_sale_prices."
    },
    {
      "@id": "acom:orderCount",
      "@type": "rdf:Property",
      "rdfs:label": "orderCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:DailySales"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "number of orders placed that day that were paid and not cancelled."
    },
    {
      "@id": "acom:orderId",
      "@type": "rdf:Property",
      "rdfs:label": "orderId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        },
        {
          "@id": "acom:MemberCoupon"
        },
        {
          "@id": "acom:OrderLineSummary"
        },
        {
          "@id": "acom:OrderSummary"
        },
        {
          "@id": "acom:Refund"
        },
        {
          "@id": "schema:Action"
        },
        {
          "@id": "schema:OrderItem"
        },
        {
          "@id": "schema:PayAction"
        },
        {
          "@id": "schema:Review"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Order"
        },
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the order (ord_ id)."
    },
    {
      "@id": "acom:orderItemId",
      "@type": "rdf:Property",
      "rdfs:label": "orderItemId",
      "schema:domainIncludes": [
        {
          "@id": "acom:ClaimItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:OrderItem"
        }
      ],
      "rdfs:comment": "order line claimed (oln_ id)."
    },
    {
      "@id": "acom:output",
      "@type": "rdf:Property",
      "rdfs:label": "output",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "step output, for example the tool result or the plan."
    },
    {
      "@id": "acom:outputTokens",
      "@type": "rdf:Property",
      "rdfs:label": "outputTokens",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "tokens received."
    },
    {
      "@id": "acom:page",
      "@type": "rdf:Property",
      "rdfs:label": "page",
      "schema:domainIncludes": [
        {
          "@id": "schema:WebPageElement"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "page the slot is on: main, category, product or search (list_display_slots page values)."
    },
    {
      "@id": "acom:paidAt",
      "@type": "rdf:Property",
      "rdfs:label": "paidAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:PayAction"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the payment completed."
    },
    {
      "@id": "acom:paymentId",
      "@type": "rdf:Property",
      "rdfs:label": "paymentId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Refund"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:PayAction"
        }
      ],
      "rdfs:comment": "payment the money goes back to (pay_ id); NULL for store credit."
    },
    {
      "@id": "acom:percentOff",
      "@type": "rdf:Property",
      "rdfs:label": "percentOff",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        },
        {
          "@id": "schema:Offer"
        },
        {
          "@id": "schema:UnitPriceSpecification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Number"
        }
      ],
      "rdfs:comment": "The requested discount behind a computed sale price, 0-100."
    },
    {
      "@id": "acom:pickupWindow",
      "@type": "rdf:Property",
      "rdfs:label": "pickupWindow",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "carrier pickup window {start, end}; NULL for drop-off."
    },
    {
      "@id": "acom:plan",
      "@type": "rdf:Property",
      "rdfs:label": "plan",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "the WriteOp plan that commit applies unchanged."
    },
    {
      "@id": "acom:policyVersion",
      "@type": "rdf:Property",
      "rdfs:label": "policyVersion",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "policy snapshot hash used by checks."
    },
    {
      "@id": "acom:preferenceKey",
      "@type": "rdf:Property",
      "rdfs:label": "preferenceKey",
      "schema:domainIncludes": [
        {
          "@id": "acom:Preference"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:PreferenceKey"
        }
      ],
      "rdfs:comment": "What a remembered preference is about.",
      "rdfs:subPropertyOf": {
        "@id": "schema:propertyID"
      }
    },
    {
      "@id": "acom:previewId",
      "@type": "rdf:Property",
      "rdfs:label": "previewId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Refund"
        },
        {
          "@id": "schema:Action"
        },
        {
          "@id": "schema:ListItem"
        },
        {
          "@id": "schema:Message"
        },
        {
          "@id": "schema:Order"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Action"
        },
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "preview the step created (pv_ id)."
    },
    {
      "@id": "acom:previewState",
      "@type": "rdf:Property",
      "rdfs:label": "previewState",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:PreviewState"
        }
      ],
      "rdfs:comment": "open until committed, expired or superseded. values: preview_state"
    },
    {
      "@id": "acom:productGroupId",
      "@type": "rdf:Property",
      "rdfs:label": "productGroupId",
      "schema:domainIncludes": [
        {
          "@id": "acom:CategoryPlacement"
        },
        {
          "@id": "schema:QuantitativeValue"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:ProductGroup"
        }
      ],
      "rdfs:comment": "product measured (prd_ id)."
    },
    {
      "@id": "acom:promotionId",
      "@type": "rdf:Property",
      "rdfs:label": "promotionId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Coupon"
        },
        {
          "@id": "acom:DisplayBooking"
        },
        {
          "@id": "schema:OrderItem"
        },
        {
          "@id": "schema:UnitPriceSpecification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "rdfs:comment": "promotion whose price or discount applied to the line."
    },
    {
      "@id": "acom:promotionStatus",
      "@type": "rdf:Property",
      "rdfs:label": "promotionStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:PromotionStatus"
        }
      ],
      "rdfs:comment": "Where a promotion is in its life."
    },
    {
      "@id": "acom:purpose",
      "@type": "rdf:Property",
      "rdfs:label": "purpose",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "why it was called, for example route, plan, arguments or reply."
    },
    {
      "@id": "acom:rank",
      "@type": "rdf:Property",
      "rdfs:label": "rank",
      "schema:domainIncludes": [
        {
          "@id": "schema:MemberProgramTier"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "Order of a tier within its program; higher is better."
    },
    {
      "@id": "acom:reasonText",
      "@type": "rdf:Property",
      "rdfs:label": "reasonText",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the shopper's own words, up to 500 characters."
    },
    {
      "@id": "acom:recipientContact",
      "@type": "rdf:Property",
      "rdfs:label": "recipientContact",
      "schema:domainIncludes": [
        {
          "@id": "acom:GiftOrder"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the email or phone the accept link goes to; used for this gift only and never saved to anyone's profile."
    },
    {
      "@id": "acom:recipientCount",
      "@type": "rdf:Property",
      "rdfs:label": "recipientCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:Campaign"
        },
        {
          "@id": "acom:CampaignSend"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        },
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "shoppers it was addressed to."
    },
    {
      "@id": "acom:recordsBenefitOnly",
      "@type": "rdf:Property",
      "rdfs:label": "recordsBenefitOnly",
      "schema:domainIncludes": [
        {
          "@id": "acom:Coupon"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true: the coupon records the promotion's benefit and adds no discount of its own."
    },
    {
      "@id": "acom:refundEstimate",
      "@type": "rdf:Property",
      "rdfs:label": "refundEstimate",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 code of refund_estimate_value."
    },
    {
      "@id": "acom:refundMethod",
      "@type": "rdf:Property",
      "rdfs:label": "refundMethod",
      "schema:domainIncludes": [
        {
          "@id": "acom:Refund"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:RefundMethod"
        }
      ],
      "rdfs:comment": "Where the money goes back."
    },
    {
      "@id": "acom:refundStatus",
      "@type": "rdf:Property",
      "rdfs:label": "refundStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:Refund"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:RefundStatus"
        }
      ],
      "rdfs:comment": "Where a refund is."
    },
    {
      "@id": "acom:registeredAt",
      "@type": "rdf:Property",
      "rdfs:label": "registeredAt",
      "schema:domainIncludes": [
        {
          "@id": "schema:Person"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when the shopper created the account."
    },
    {
      "@id": "acom:rejectedAt",
      "@type": "rdf:Property",
      "rdfs:label": "rejectedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:ChangeSet"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
      "rdfs:comment": "when a person rejected the set."
    },
    {
      "@id": "acom:rejectionReason",
      "@type": "rdf:Property",
      "rdfs:label": "rejectionReason",
      "schema:domainIncludes": [
        {
          "@id": "acom:ChangeSet"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the reason the person gave when rejecting."
    },
    {
      "@id": "acom:replacement",
      "@type": "rdf:Property",
      "rdfs:label": "replacement",
      "schema:domainIncludes": [
        {
          "@id": "acom:ClaimItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Product"
        }
      ],
      "rdfs:comment": "variant sent instead for an exchange (var_ id); NULL otherwise."
    },
    {
      "@id": "acom:replyText",
      "@type": "rdf:Property",
      "rdfs:label": "replyText",
      "schema:domainIncludes": [
        {
          "@id": "schema:Message"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "short text answer shown with the blocks."
    },
    {
      "@id": "acom:requestText",
      "@type": "rdf:Property",
      "rdfs:label": "requestText",
      "schema:domainIncludes": [
        {
          "@id": "acom:ChangeSet"
        },
        {
          "@id": "acom:Task"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the person's words, first request then each edit by conversation."
    },
    {
      "@id": "acom:resultId",
      "@type": "rdf:Property",
      "rdfs:label": "resultId",
      "schema:domainIncludes": [
        {
          "@id": "schema:ListItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "id the item produced when it ran, for example promo_1042."
    },
    {
      "@id": "acom:revenue",
      "@type": "rdf:Property",
      "rdfs:label": "revenue",
      "schema:domainIncludes": [
        {
          "@id": "acom:DailySales"
        },
        {
          "@id": "acom:OrderLineSummary"
        },
        {
          "@id": "acom:OrderSummary"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:MonetaryAmount"
        }
      ],
      "rdfs:comment": "ISO 4217 code of revenue_value."
    },
    {
      "@id": "acom:safetyStock",
      "@type": "rdf:Property",
      "rdfs:label": "safetyStock",
      "schema:domainIncludes": [
        {
          "@id": "schema:Offer"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "Units kept back from sale; inventory_level minus this is what shoppers can buy."
    },
    {
      "@id": "acom:saleType",
      "@type": "rdf:Property",
      "rdfs:label": "saleType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Product"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:SaleType"
        }
      ],
      "rdfs:comment": "how the variant is sold. values: sale_type"
    },
    {
      "@id": "acom:salesChannel",
      "@type": "rdf:Property",
      "rdfs:label": "salesChannel",
      "schema:domainIncludes": [
        {
          "@id": "acom:Cart"
        },
        {
          "@id": "schema:Order"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:SalesChannel"
        }
      ],
      "rdfs:comment": "where the cart was built. values: sales_channel"
    },
    {
      "@id": "acom:scheduledTime",
      "@type": "rdf:Property",
      "rdfs:label": "scheduledTime",
      "schema:domainIncludes": [
        {
          "@id": "acom:Campaign"
