          "@id": "acom:TierEvaluation"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "the tier moves made: [{customer_id, from_tier_id, to_tier_id, direction, reason, from_since}], kept so the run can be undone."
    },
    {
      "@id": "acom:needsApproval",
      "@type": "rdf:Property",
      "rdfs:label": "needsApproval",
      "schema:domainIncludes": [
