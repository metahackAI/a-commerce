          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Boolean"
        }
      ],
      "rdfs:comment": "true when only an approved change set may run it."
    },
    {
      "@id": "acom:neologisms",
      "@type": "rdf:Property",
      "rdfs:label": "neologisms",
      "schema:domainIncludes": [
