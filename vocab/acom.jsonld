      "@id": "acom:latency",
      "@type": "rdf:Property",
      "rdfs:label": "latency",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
