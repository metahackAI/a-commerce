      "@id": "acom:productGroupId",
      "@type": "rdf:Property",
      "rdfs:label": "productGroupId",
      "schema:domainIncludes": [
        {
          "@id": "acom:CategoryPlacement"
        },
        {
          "@id": "schema:QuantitativeValue"
        },
        {
          "@id": "schema:TypeAndQuantityNode"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:ProductGroup"
        }
      ],
      "rdfs:comment": "product measured (prd_ id)."
    },
    {
      "@id": "acom:productImportId",
      "@type": "rdf:Property",
      "rdfs:label": "productImportId",
      "schema:domainIncludes": [
        {
          "@id": "schema:DataFeedItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:ProductImport"
        }
      ],
      "rdfs:comment": "the import run that read the row (imp_ id)."
    },
    {
      "@id": "acom:promotionId",
      "@type": "rdf:Property",
      "rdfs:label": "promotionId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Coupon"
        },
        {
          "@id": "acom:DisplayBooking"
        },
        {
          "@id": "schema:OrderItem"
        },
        {
          "@id": "schema:UnitPriceSpecification"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "rdfs:comment": "promotion whose price or discount applied to the line."
    },
    {
      "@id": "acom:promotionStatus",
      "@type": "rdf:Property",
      "rdfs:label": "promotionStatus",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:PromotionStatus"
        }
      ],
      "rdfs:comment": "Where a promotion is in its life."
    },
    {
      "@id": "acom:promotionTerms",
      "@type": "rdf:Property",
      "rdfs:label": "promotionTerms",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "parameters of the type: {threshold_benefit: amount_off or free_shipping, buy_quantity, get_quantity, bundle_price: {value, currency}, cost_share: {store, seller} rates 0-1}."
    },
    {
      "@id": "acom:promotionType",
      "@type": "rdf:Property",
      "rdfs:label": "promotionType",
      "schema:domainIncludes": [
        {
          "@id": "acom:Promotion"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:PromotionType"
        }
      ],
      "rdfs:comment": "kind of benefit a promotion made by create_promotion gives; NULL for member and sale prices (set_sale_prices). values: promotion_type"
    },
    {
      "@id": "acom:prompt",
      "@type": "rdf:Property",
      "rdfs:label": "prompt",
      "schema:domainIncludes": [
        {
          "@id": "schema:ImageObject"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "what the operator asked the image to show."
    },
    {
      "@id": "acom:purpose",
      "@type": "rdf:Property",
      "rdfs:label": "purpose",
      "schema:domainIncludes": [
        {
          "@id": "acom:IdentityVerification"
        },
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "why it was called, for example route, plan, arguments or reply."
    },
    {
      "@id": "acom:rank",
      "@type": "rdf:Property",
      "rdfs:label": "rank",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        },
        {
          "@id": "acom:EventEntry"
        },
        {
          "@id": "acom:EventReward"
        },
        {
          "@id": "schema:MemberProgramTier"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        }
      ],
      "rdfs:comment": "Order of a tier within its program; higher is better."
    },
    {
      "@id": "acom:reason",
      "@type": "rdf:Property",
      "rdfs:label": "reason",
      "schema:domainIncludes": [
        {
          "@id": "acom:DrawRecord"
        },
        {
          "@id": "acom:RecoveryRequest"
        },
        {
          "@id": "acom:Remedy"
        },
        {
          "@id": "acom:TierChange"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "why it was requested, in a sentence."
    },
    {
      "@id": "acom:reasonText",
      "@type": "rdf:Property",
      "rdfs:label": "reasonText",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        },
        {
          "@id": "acom:Withdrawal"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the shopper's own words, up to 500 characters."
    },
    {
      "@id": "acom:reasons",
      "@type": "rdf:Property",
      "rdfs:label": "reasons",
      "schema:domainIncludes": [
        {
          "@id": "acom:Withdrawal"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:WithdrawalReason"
        }
      ],
      "rdfs:comment": "the reasons the member picked; every element is a word from the list. values: withdrawal_reason"
    },
    {
      "@id": "acom:recipientContact",
      "@type": "rdf:Property",
      "rdfs:label": "recipientContact",
      "schema:domainIncludes": [
        {
          "@id": "acom:GiftOrder"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the email or phone the accept link goes to; used for this gift only and never saved to anyone's profile."
    },
    {
      "@id": "acom:recipientCount",
      "@type": "rdf:Property",
      "rdfs:label": "recipientCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:Campaign"
        },
        {
          "@id": "acom:CampaignSend"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Integer"
        },
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "shoppers it was addressed to."
    },
    {
      "@id": "acom:recordedAt",
      "@type": "rdf:Property",
      "rdfs:label": "recordedAt",
      "schema:domainIncludes": [
        {
          "@id": "acom:ConsentRecord"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:DateTime"
        }
      ],
