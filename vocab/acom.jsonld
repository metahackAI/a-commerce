      "@id": "acom:openFields",
      "@type": "rdf:Property",
      "rdfs:label": "openFields",
      "schema:domainIncludes": [
        {
          "@id": "schema:DataFeedItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "required fields that were missing or unclear in the sheet, from catalog.yml import.required_fields, for example {material}; empty when none."
    },
    {
      "@id": "acom:operation",
      "@type": "rdf:Property",
      "rdfs:label": "operation",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "logical address of the write, for example promotion.offer.set_sale_prices."
    },
    {
      "@id": "acom:orderCount",
      "@type": "rdf:Property",
      "rdfs:label": "orderCount",
      "schema:domainIncludes": [
        {
          "@id": "acom:DailySales"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "number of orders placed that day that were paid and not cancelled."
    },
    {
      "@id": "acom:orderId",
      "@type": "rdf:Property",
      "rdfs:label": "orderId",
      "schema:domainIncludes": [
        {
          "@id": "acom:Claim"
        },
        {
          "@id": "acom:EventEntry"
        },
        {
          "@id": "acom:LoyaltyTransaction"
        },
        {
          "@id": "acom:MemberCoupon"
        },
        {
          "@id": "acom:OrderLineSummary"
        },
        {
          "@id": "acom:OrderSummary"
        },
        {
          "@id": "acom:Refund"
        },
        {
          "@id": "schema:Action"
        },
        {
          "@id": "schema:OrderItem"
        },
        {
          "@id": "schema:PayAction"
        },
        {
          "@id": "schema:Review"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:Order"
        },
        {
          "@id": "schema:Text"
        }
      ],
      "rdfs:comment": "the order (ord_ id)."
    },
    {
      "@id": "acom:orderItemId",
      "@type": "rdf:Property",
      "rdfs:label": "orderItemId",
      "schema:domainIncludes": [
        {
          "@id": "acom:ClaimItem"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:OrderItem"
        }
      ],
      "rdfs:comment": "order line claimed (oln_ id)."
    },
    {
      "@id": "acom:organizationType",
      "@type": "rdf:Property",
      "rdfs:label": "organizationType",
      "schema:domainIncludes": [
        {
          "@id": "schema:Organization"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "acom:OrganizationType"
        }
      ],
      "rdfs:comment": "what kind of organization this is (API: org_type). values: organization_type"
    },
    {
      "@id": "acom:output",
      "@type": "rdf:Property",
      "rdfs:label": "output",
      "schema:domainIncludes": [
        {
          "@id": "schema:Action"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "step output, for example the tool result or the plan."
    },
