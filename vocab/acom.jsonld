          "@id": "acom:Claim"
        }
      ],
      "schema:rangeIncludes": [
        {
          "@id": "schema:StructuredValue"
        }
      ],
      "rdfs:comment": "carrier pickup window {start, end}; NULL for drop-off."
    },
