# Copy to models.env (git-ignored). Becomes Secret acom-models, read by the agent only.
# Every key is optional: the agent starts without them. Uncomment and fill in the ones you have.
# META_API_KEY=
# META_API_BASE_URL=
# SPARK_MODEL=
# With components/models-vllm, the worker model is served in the cluster:
# GLIMMER_BASE_URL=http://models:8000/v1
# GLIMMER_MODEL=
