# Copy to database.env (git-ignored). Becomes Secret acom-database.
# The roles and their local passwords come from infra/postgres/init.sql; `postgres` is the
# in-cluster Service of the postgres component.
# Services connect as acom_app (row-level security applies).
DATABASE_URL=postgres://acom_app:acom_app@postgres:5432/acom
# The migrate Job connects as acom_owner.
MIGRATION_DATABASE_URL=postgres://acom_owner:acom_owner@postgres:5432/acom
